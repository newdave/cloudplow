[run]
branch = true
source = .
omit =
    tests/*
    venv/*
    .github/*

[report]
skip_empty = true
# code a test can only reach by re-running Python itself
exclude_also =
    # script entry point
    if __name__ == .__main__.:
    # import guard that exits when a requirement is missing
    except ImportError:
    # typing.Protocol method stubs are never executed
    class \w+\(Protocol\):
