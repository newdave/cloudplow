#!/usr/bin/env bash
#MISE description="Enable, disable or show the GitHub repository settings the CI and workflows rely on"
#USAGE arg "<action>" help="enable, disable or status" {
#USAGE   choices "enable" "disable" "status"
#USAGE }
#USAGE flag "--dry-run" help="Print the changes instead of making them"
#USAGE flag "--strict" help="enable: also require the CI gate for repository admins (no direct pushes to the default branch)"
#USAGE flag "--repo <repo>" help="owner/name; defaults to the origin remote"
#
# Settings managed:
#   1. A repository ruleset named "CI gate" that requires the "CI gate" check on the default branch.
#      Repository admins may bypass it unless --strict, so direct pushes by the owner keep working.
#   2. "Allow GitHub Actions to create and approve pull requests" (used by the Upstream Sync workflow).
#      The default GITHUB_TOKEN permission is left as it is.
#   3. Private vulnerability reporting (linked from SECURITY.md).
# Needs an authenticated gh with admin rights on the repository.
set -euo pipefail

action=${usage_action:?}
dry_run=${usage_dry_run:-false}
strict=${usage_strict:-false}

RULESET_NAME="CI gate"
REQUIRED_CHECK="CI gate"
GITHUB_ACTIONS_APP_ID=15368     # check runs reported by GitHub Actions
ADMIN_ROLE_ID=5                 # the built-in repository admin role, for bypass_actors

repo=${usage_repo:-$(git remote get-url origin | sed -E 's#(\.git)?$##; s#^.*github\.com[:/]##')}
[[ $repo == */* ]] || { echo "Cannot tell the repository from the origin remote; pass --repo owner/name" >&2; exit 2; }

api() { gh api -H "Accept: application/vnd.github+json" "$@"; }

# mutate METHOD PATH [JSON]: make a change, or describe it with --dry-run
mutate() {
    local method=$1 path=$2 body=${3:-}
    if [[ $dry_run == true ]]; then
        echo "would: $method $path${body:+ $body}"
        return
    fi
    if [[ -n $body ]]; then
        api -X "$method" "$path" --input - <<<"$body" >/dev/null
    else
        api -X "$method" "$path" >/dev/null
    fi
}

ruleset_id() {
    api "repos/$repo/rulesets" --jq ".[] | select(.name == \"$RULESET_NAME\") | .id" | head -n 1
}

ruleset_body() {
    local bypass='[]'
    [[ $strict == true ]] || bypass="[{\"actor_id\": $ADMIN_ROLE_ID, \"actor_type\": \"RepositoryRole\", \"bypass_mode\": \"always\"}]"
    jq -n --arg name "$RULESET_NAME" --arg check "$REQUIRED_CHECK" \
          --argjson app "$GITHUB_ACTIONS_APP_ID" --argjson bypass "$bypass" '{
        name: $name,
        target: "branch",
        enforcement: "active",
        conditions: {ref_name: {include: ["~DEFAULT_BRANCH"], exclude: []}},
        bypass_actors: $bypass,
        rules: [{type: "required_status_checks",
                 parameters: {strict_required_status_checks_policy: false,
                              required_status_checks: [{context: $check, integration_id: $app}]}}]
    }'
}

# set_actions_prs true|false, keeping the default workflow permission unchanged
set_actions_prs() {
    local current
    current=$(api "repos/$repo/actions/permissions/workflow" --jq '.default_workflow_permissions')
    mutate PUT "repos/$repo/actions/permissions/workflow" \
        "{\"default_workflow_permissions\": \"$current\", \"can_approve_pull_request_reviews\": $1}"
}

status() {
    local id actions_prs reporting
    id=$(ruleset_id)
    if [[ -n $id ]]; then
        echo "Required check '$REQUIRED_CHECK': on (ruleset $id, $(api "repos/$repo/rulesets/$id" --jq \
            'if (.bypass_actors | length) > 0 then "admins may bypass" else "strict: no bypass" end'))"
    else
        echo "Required check '$REQUIRED_CHECK': off"
    fi
    actions_prs=$(api "repos/$repo/actions/permissions/workflow" --jq '.can_approve_pull_request_reviews')
    echo "Actions may create pull requests: $([[ $actions_prs == true ]] && echo on || echo off)"
    reporting=$(api "repos/$repo/private-vulnerability-reporting" --jq '.enabled')
    echo "Private vulnerability reporting: $([[ $reporting == true ]] && echo on || echo off)"
}

case $action in
    status)
        echo "$repo"
        status
        ;;
    enable)
        id=$(ruleset_id)
        if [[ -n $id ]]; then
            mutate PUT "repos/$repo/rulesets/$id" "$(ruleset_body)"
        else
            mutate POST "repos/$repo/rulesets" "$(ruleset_body)"
        fi
        set_actions_prs true
        mutate PUT "repos/$repo/private-vulnerability-reporting"
        [[ $dry_run == true ]] || { echo "Enabled on $repo:"; status; }
        ;;
    disable)
        id=$(ruleset_id)
        if [[ -n $id ]]; then
            mutate DELETE "repos/$repo/rulesets/$id"
        else
            echo "No '$RULESET_NAME' ruleset to remove"
        fi
        set_actions_prs false
        mutate DELETE "repos/$repo/private-vulnerability-reporting"
        [[ $dry_run == true ]] || { echo "Disabled on $repo:"; status; }
        ;;
esac
