#!/usr/bin/env bash
#MISE description="Run the unit tests (all, or the given test names)"
#USAGE arg "[tests]" var=#true help="unittest names, e.g. tests.test_rclone or tests.test_rclone.ThrottlerTests"
set -euo pipefail
# shellcheck source=../lib.sh
. "${MISE_PROJECT_ROOT:-.}/.mise/lib.sh"
need_venv

if [[ -n ${usage_tests:-} ]]; then
    # shellcheck disable=SC2086  # one name per word
    exec "$PY" -m unittest $usage_tests
fi
exec "$PY" -m unittest discover -s tests
