#!/usr/bin/env bash
#MISE description="Run the tests under coverage and print the report"
#USAGE flag "--html" help="Also write an HTML report to htmlcov/"
set -euo pipefail
# shellcheck source=../lib.sh
. "${MISE_PROJECT_ROOT:-.}/.mise/lib.sh"
need_venv
"$PY" -c 'import coverage' 2>/dev/null || die "coverage is not installed; run: mise run setup"

"$PY" -m coverage erase
"$PY" -m coverage run -m unittest discover -s tests
"$PY" -m coverage report -m --skip-covered
if [[ ${usage_html:-false} == true ]]; then
    "$PY" -m coverage html -q
    note "HTML report: $ROOT/htmlcov/index.html"
fi
